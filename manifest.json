{
  "manifest_version": 3,
  "name": "Jev Content Guard",
  "version": "1.6",
  "description": "Filters fraud, ads, AI slop, spam, clickbait, plagiarism & toxicity, and highlights keywords on page using TypeSafe Jev AI.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}